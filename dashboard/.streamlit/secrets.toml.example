# Copie este arquivo para dashboard/.streamlit/secrets.toml (local)
# ou cole o conteúdo na aba "Settings > Secrets" do Streamlit Community Cloud.
# NUNCA faça commit de secrets.toml com credenciais reais.

[postgres]
host = "SEU_IP_PUBLICO_CLOUD_SQL_OU_127.0.0.1"
port = 5432
database = "observatorio_stem"
user = "etl_user"
password = "SUA_SENHA_FORTE_AQUI"
sslmode = "require"
